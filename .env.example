# ══════════════════════════════════════════════════════════════
#  Spider · variables de entorno para DESARROLLO LOCAL
#  Copia este archivo a `.env` (git-ignored) y ajústalo.
#  En Render NO se usa este archivo: las variables se definen en
#  el dashboard / render.yaml y DATABASE_URL la inyecta la BD.
# ══════════════════════════════════════════════════════════════

# ── Base de datos (una sola instancia Postgres, un schema por app) ──
POSTGRES_DB=spider
POSTGRES_USER=spider_user
# El password vive en la variable de entorno BD_PASS (no lo escribas aquí).
# docker-compose lo toma de tu shell: export BD_PASS=...
BD_PASS=${BD_PASS}

# Host/puerto que ven los backends dentro de la red de docker-compose.
DB_HOST=db
DB_PORT=5432

# ── Google OAuth (login) ──────────────────────────────────────
# Crea credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# Secreto para firmar las sesiones/JWT del gateway de auth (32+ chars).
AUTH_JWT_SECRET=change-this-to-a-long-random-string

# URL pública del gateway (para construir el redirect_uri de OAuth).
PUBLIC_BASE_URL=http://localhost:8080

# ── IA (Gemini · app "gastos") — lectura de recibos desde una foto ──
# API key de Google AI Studio (sin ella la app funciona pero sin escaneo IA).
GEMINI_API_KEY=
# Modelo por defecto (env-driven; ver CLAUDE.md).
GEMINI_MODEL=gemini-flash-latest
# Presupuesto de "pensamiento" en tokens, SOLO para modelos Gemini 2.5
# (flash-latest, 2.5-flash…). Un valor acotado le da unos segundos para leer
# bien el recibo; con <0 se omite. En modelos 2.0/1.5 se ignora automáticamente
# (no soportan thinking y devolverían 400).
GEMINI_THINKING_BUDGET=2048
# Timeout de la llamada a Gemini (segundos); ha de cubrir ese pensamiento.
GEMINI_TIMEOUT_SECONDS=90

# ── MCP de Coolify (para que Claude Code lea deploys/logs) ────
# Token Sanctum de https://master.muvatec.com (Security → API Tokens).
# Lo consume .mcp.json como ${COOLIFY_MCP_TOKEN}. NUNCA lo escribas en el repo.
COOLIFY_MCP_TOKEN=
